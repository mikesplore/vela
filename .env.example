# Vela environment variables
#
# `vela --setup` writes a complete .env file. This example keeps optional
# integrations commented so it is safe to copy and edit manually.

# Autofilled by setup
# Agent + local service credentials (systemd: vela-agent EnvironmentFile)
USERNAME=
PASSWORD=
LOCAL_SERVICE_USERNAME=
LOCAL_SERVICE_PASSWORD=
LOCAL_SERVICE_URL=http://127.0.0.1:8765
LOCAL_SERVICE_TOKEN_PATH=/auth/token
LOCAL_SERVICE_TIMEOUT=300
RELAY_READ_TIMEOUT=300
START_AGENT=true

# Filled during pairing (normally leave these empty)
AGENT_ID=
AGENT_SECRET=
AGENT_CREDENTIAL=
RELAY_SECRET=

# Setup defaults / local identity
VPS_URL=
PAIRING_STATUS_POLL_INTERVAL=3
PAIRING_STATUS_TIMEOUT=600
PAIRING_BROWSER_UI=true
AGENT_NAME=
AGENT_MAX_CONCURRENT_REQUESTS=8
VELA_ALLOW_REMOTE_BIND=0
VELA_TRUSTED_PROXY_IPS=[]
VELA_LOG_LEVEL=INFO

# Optional pairing / MCP overrides
# MCP_SERVER_URL=
# PAIRING_AGENT_ID=
# TENANT_HINT=
# DEVICE_FINGERPRINT=
# REMOTEAGENT_CONFIG_PATH=
# PUBLIC_ADDRESS=
# METADATA=
# LOCAL_SERVICE_AUTH_TOKEN=
# LOCAL_SERVICE_AUTH_TOKEN_EXPIRES=

# Optional assistant settings
# ASSISTANT_ACTION_PIN=
# FIREWORKS_API_KEY=
# IPINFO_TOKEN=
VELA_ASSISTANT_ENABLE_THINKING=false
VELA_FIREWORKS_API_URL=https://api.fireworks.ai/inference/v1
VELA_FIREWORKS_MODEL=accounts/fireworks/models/qwen3p7-plus

# Optional email + push alerts (configure FCM on velavps)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RECIPIENT_EMAIL=
VELA_ALERT_TIMEZONE=UTC
VELA_DAILY_SUMMARY_TIME=18:00
VELA_CPU_ALERT_THRESHOLD=85
VELA_MEMORY_ALERT_THRESHOLD=85
VELA_DISK_ALERT_THRESHOLD=80
VELA_SPIKE_CHECK_INTERVAL_MINUTES=5
VELA_ALERT_COOLDOWN_MINUTES=15
# VELA_ALERTMANAGER_WEBHOOK_SECRET=

# Optional Spotify OAuth
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=

# Optional Gatekeeperd admin API (Vela assistant tools)
# Local: http://127.0.0.1:8080  — Hosted: https://gateapi.example.com
# GATEKEEPER_BASE_URL=
# Option A: long-lived JWT from gatekeeperd login
# GATEKEEPER_TOKEN=
# Option B: login on each session (token cached in memory)
# GATEKEEPER_EMAIL=
# GATEKEEPER_PASSWORD=
GATEKEEPER_TIMEOUT=10

# Default performance / browser onboarding settings
VELA_NETWORK_PUBLIC_IP_CACHE_SECONDS=120
VELA_NETWORK_WIFI_LIST_CACHE_SECONDS=45
VELA_DESKTOP_ENV_CHECK_INTERVAL_SECONDS=30
VELA_BROWSER_ONBOARDING=true
VELA_BROWSER_ONBOARDING_TIMEOUT=300
VELA_BROWSER_DEPENDENCY_TIMEOUT=300

# Server-only settings (VELA_HOST, VELA_SECRET_KEY, etc.) live in config.yaml.
# Request/resource limits can also be set in config.yaml using their field names.
